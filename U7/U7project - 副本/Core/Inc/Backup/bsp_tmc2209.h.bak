#ifndef __BSP_TMC2209_H
#define __BSP_TMC2209_H

#include "main.h"
#include <stdint.h>


#define TMC_GCONF         0x00   /* 全局配置 */
#define TMC_IHOLD_IRUN    0x10   /* 保持/运行电流 */
#define TMC_TPOWERDOWN    0x11   /* 静止降流延时 */
#define TMC_CHOPCONF      0x6C   /* 斩波配置 */
#define TMC_PWMCONF       0x70   /* PWM/StealthChop 配置 */


void    TMC_Init(void);
void    TMC_SetDefaults(void);
uint8_t TMC_WriteReg(uint8_t reg, uint32_t val);
uint8_t TMC_ReadReg(uint8_t reg, uint32_t *val);

#endif
