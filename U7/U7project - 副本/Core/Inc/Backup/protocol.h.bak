#ifndef __PROTOCOL_H
#define __PROTOCOL_H

#include "main.h"
#include <stdint.h>

/*===== 帧定义 (与 U1 protocol_u7.h 镜像) =====*/
#define PROTO_MAX_DATA     256

/*===== 命令码 (2字节) =====*/
#define PROTO_CMD_PING         0x0121
#define PROTO_CMD_GET_VERSION  0x0122
#define PROTO_CMD_MOTOR_STEP   0x0123
#define PROTO_CMD_MOTOR_STOP   0x0124
#define PROTO_CMD_READ_INPUT   0x0125
#define PROTO_CMD_SELF_TEST    0x0126
#define PROTO_CMD_RESET        0x0127

/*===== 方向 =====*/
#define PROTO_DIR_CW    0x00
#define PROTO_DIR_CCW   0x01

/*===== 状态码 =====*/
#define PROTO_STATUS_OK    0x00
#define PROTO_STATUS_ERROR 0xFF

/*===== 固件版本 =====*/
#define PROTO_FW_MAJOR  1
#define PROTO_FW_MINOR  0

/*===== API =====*/
void PROTO_Init(void);
void PROTO_Run(void);

#endif
